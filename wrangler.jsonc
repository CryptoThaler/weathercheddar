// Cloudflare Worker "weathercheddar": serves the ORIGINAL Weather Cheddar app
// (Worker "weather-cheddar-path-proxy", public path /weather-cheddar/) at the new
// hyphen-free address https://www.cryptothaler.com/weathercheddar/.
//
// How: requests to /weathercheddar/* are forwarded over a service binding to the
// original Worker as /weather-cheddar/*, and "/weather-cheddar" in returned HTML, JS,
// JSON, CSS and Location headers is rewritten to "/weathercheddar" so visitors stay on
// the new address. The original Worker, its code and its /weather-cheddar route are untouched.
// Docs: https://developers.cloudflare.com/workers/runtime-apis/bindings/service-bindings/
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "weathercheddar",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-11-05",
  // Keep the *.workers.dev URL so the alias can be checked before routes go live.
  "workers_dev": true,
  // Requires cryptothaler.com on Cloudflare DNS with proxied (orange-cloud) www / apex records.
  // Do NOT add /weather-cheddar* here: that path belongs to "weather-cheddar-path-proxy".
  "routes": [
    { "pattern": "www.cryptothaler.com/weathercheddar*", "zone_name": "cryptothaler.com" },
    { "pattern": "cryptothaler.com/weathercheddar*", "zone_name": "cryptothaler.com" }
  ],
  // Must match the existing Worker's name exactly (same Cloudflare account).
  "services": [{ "binding": "LEGACY", "service": "weather-cheddar-path-proxy" }],
  "observability": { "enabled": true }
}
